# --- Database (SQL Server) ---
# Windows Authentication is used when DB_USERNAME/DB_PASSWORD are empty.
DB_SERVER=.
DB_NAME=BankDB
DB_DRIVER=ODBC+Driver+18+for+SQL+Server
DB_ECHO=false
DB_USERNAME=
DB_PASSWORD=

# --- SMS provider (sms.ir / app.sms.ir) ---
# API key from the sms.ir panel (Settings -> API Key). Never commit a real key.
SMS_API_KEY=your-api-key-here
# Numeric id of the Verify template you created in the sms.ir panel.
SMS_PATTERN_CODE=your-template-id-here
# Template placeholder name that carries the code (written as #Code# in the panel).
SMS_OTP_ATTRIBUTE=Code
# Optional override of the provider base URL.
SMS_API_BASE_URL=https://api.sms.ir
# Route OTP delivery through RabbitMQ (true) or call sms.ir directly (false).
SMS_USE_QUEUE=true

# --- RabbitMQ broker ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
# Queue that carries OTP jobs (visible in http://localhost:15672).
RABBITMQ_OTP_QUEUE=otp_sms_queue
# Seconds the app waits for the worker's delivery confirmation.
RABBITMQ_REPLY_TIMEOUT=8

# --- Profile photos ---
# Folder where uploaded profile photos are stored (relative to the project).
PROFILE_PHOTO_DIR=storage/profile_photos
